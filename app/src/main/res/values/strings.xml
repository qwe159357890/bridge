<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Bridge</string>

    <!-- Bridge 辅助服务（无障碍）：模拟电源键锁屏 + 静默截屏 -->
    <string name="accessibility_service_summary">Bridge 远程辅助操作</string>
    <string name="accessibility_service_desc">Bridge 使用本服务实现远程辅助功能：1）模拟电源键锁屏——与手动按下电源键完全一致，不会触发强制密码验证；2）静默截屏——无需投屏授权、不显示任何通知；3）界面自动化——仅在您通过远程管理端主动下发指令时，才读取当前屏幕的控件信息并模拟点击、输入、滑动等操作，用于辅助定位与自动化测试。本服务不会在后台常驻监控，仅在指令触发时按需读取屏幕内容。</string>

    <!-- Bridge 极简输入法（IME）：文本输入兜底 -->
    <string name="bridge_keyboard_label">Bridge 输入辅助</string>

    <!-- Bridge 通知监听：通知域自动化 -->
    <string name="bridge_notification_label">Bridge 通知读取</string>

</resources>
