# GitHub 鉴权配置模板 —— 复制为 github.env 并填入真实值
# 用途：让 AI 助手能【自动建仓库】→ push → 触发打包 → 下载 APK，全程无需你手动操作
# 安全：github.env 已被 .gitignore 排除，绝不提交到仓库

# GitHub 用户名（你只需提供这个 + token）
GITHUB_USER=你的用户名

# 仓库名（AI 会自动用 GitHub API 创建，无需你手动建）
GITHUB_REPO=bridge

# 仓库是否私有（true=私有，false=公开）
# 注意：gh-proxy 代理加速只对公开仓库生效；私有仓库会自动回退 token 直连
GITHUB_PRIVATE=false

# GitHub Personal Access Token（PAT）
# 需勾选权限：repo（完整读写，含建仓库）、workflow（触发 Actions）
# 生成地址：https://github.com/settings/tokens  → Generate new token (classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
