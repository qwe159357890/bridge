# GitHub 鉴权配置模板 —— 复制为 github.env 并填入真实值
# 用途：让 AI 助手能自动 push 到 GitHub、触发打包、下载 APK
# 安全：github.env 已被 .gitignore 排除，绝不提交到仓库

# GitHub 用户名
GITHUB_USER=你的用户名

# 仓库名（不含用户名前缀）
GITHUB_REPO=你的仓库名

# GitHub Personal Access Token（PAT）
# 需勾选权限：repo（完整读写）、workflow（触发 Actions）
# 生成地址：https://github.com/settings/tokens  → Generate new token (classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
