# ===================== Android / Gradle =====================
# Gradle 构建产物
.gradle/
build/
*/build/

# 本地配置（含签名等敏感信息）
local.properties
*.keystore
*.jks
key.properties

# 例外：内部测试阶段统一使用的固定 debug 签名 keystore（必须入库，保证本机/CI 签名一致）
!app/bridge-debug.keystore

# Android Studio / IDEA
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# ===================== Python（tools/ 脚本用） =====================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.log

# ===================== 系统文件 =====================
.DS_Store
Thumbs.db

# ===================== 敏感 / 私密文件 =====================
private_*.*
.env

# ===================== 参考源码（不纳入版本控制） =====================
references/

# ===================== AI 本地工作数据 / 编译缓存 =====================
.workbuddy/
.kotlin/
*.tsbuildinfo

# ===================== 本地发布产物 / GitHub 鉴权 =====================
releases/
github.env
gh_token.txt

# 服务端更新目录中的 APK 本体不入库（12MB 级二进制，服务器运行时手动放置）
server/data/updates/*.apk
# 服务端运行数据（媒体文件等，运行时生成）
server/data/media/
# ADB platform-tools（17MB 下载的二进制，获取与放置说明见 docs/server/design.md §20）
tools/adb/
tools/debug/.pwenv/
# 服务端运行时配置/数据（report_config_store 等生成）
server/data/report_config.json
# 服务端运行时日志（TimedRotatingFileHandler 生成，按天轮转）
server/logs/
# 临时诊断产物
tools/debug/diag_page.png
